                if ($cover) {
                    echo "<img src='" . $cover . "' alt='" . $title . "' style='width: 100%; height: 100%; object-fit: cover;' onerror=\"this.style.display='none'; this.parentElement.innerHTML='<div style=\\'color: white; font-size: 3rem; opacity: 0.3;\\'>📖</div>'\">";
                } else {
